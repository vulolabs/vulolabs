{
	"apiVersion": 3,
	"name": "vulopilot/faq",
	"title": "FAQ",
	"category": "vulopilot",
	"icon": "editor-help",
	"description": "A list of questions and answers that also outputs real FAQPage schema.org structured data for search engines.",
	"textdomain": "vulopilot",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"attributes": {
		"questions": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"question": { "type": "string" },
					"answer": { "type": "string" },
					"hidden": { "type": "boolean" },
					"imageId": { "type": "number" },
					"imageUrl": { "type": "string" }
				}
			}
		},
		"questionColor": { "type": "string" },
		"questionFontSize": { "type": "string" },
		"answerColor": { "type": "string" },
		"answerFontSize": { "type": "string" },

		"layoutMode": { "type": "string", "default": "accordion" },
		"allowMultipleOpen": { "type": "boolean", "default": true },
		"initialOpenIndex": { "type": "number", "default": null },
		"iconStyle": { "type": "string", "default": "plus-minus" },
		"iconPosition": { "type": "string", "default": "right" },
		"animationEnabled": { "type": "boolean", "default": true },
		"animationDuration": { "type": "number", "default": 250 },
		"headingLevel": { "type": "number", "default": 0 },
		"enableSchema": { "type": "boolean", "default": true },
		"appearance": { "type": "string", "default": "cards" },

		"style": { "type": "object", "default": {} }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ]
	}
}
