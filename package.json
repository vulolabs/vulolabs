{
  "name": "vulolabs",
  "version": "1.0.0",
  "private": true,
  "description": "VuloLabs Monorepo",
  "homepage": "https://vulolabs.com/",
  "license": "GPL-2.0-or-later",
  "author": "VuloLabs",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vulolabs"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:release": "pnpm -r --workspace-concurrency=1 run build:release",
    "build:zip": "pnpm -r --workspace-concurrency=1 run build:zip",
    "watch": "pnpm -r --parallel run watch",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:php",
    "lint:fix": "pnpm run fix:js && pnpm run fix:css && pnpm run fix:php",
    "lint:php": "pnpm -r --if-present run lint:php",
    "fix:php": "pnpm -r --if-present run fix:php",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "fix:js": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs --fix",
    "lint:css": "stylelint \"plugins/**/*.{css,scss}\"",
    "fix:css": "stylelint \"plugins/**/*.{css,scss}\" --fix",
    "test": "pnpm -r run test",
    "clean": "rimraf -g \"**/node_modules\" \"**/vendor\" \"**/.wireit\" \"**/.cache\" \"**/release\" \"**/dist\"",
    "clean:build": "rimraf -g \"plugins/*/assets\" \"packages/*/build\"",
    "sync:deps": "syncpack fix-mismatches",
    "watch:storybook": "pnpm -r --workspace-concurrency=Infinity --stream \"/^watch:build:storybook.*$/\"",
    "composer:install": "composer install",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@wordpress/babel-preset-default": "^8.56.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.57.0",
    "@wordpress/env": "10.23.0",
    "@wordpress/eslint-plugin": "^22.22.0",
    "@wordpress/prettier-config": "^4.57.0",
    "@wordpress/scripts": "^30.27.0",
    "autoprefixer": "^10.6.2",
    "babel-loader": "^10.1.1",
    "chalk": "^5.6.2",
    "clean-css": "^5.3.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "fs-extra": "^11.4.1",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.10.1",
    "replace-in-file": "^8.4.0",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.14.0",
    "syncpack": "^13.0.4",
    "terser": "^5.51.2",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "wireit": "^0.14.13",
    "wp-readme-to-markdown": "^1.0.1",
    "wp-textdomain": "^1.0.1"
  }
}
