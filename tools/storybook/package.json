{
  "name": "storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --if-present --workspace-concurrency=Infinity --stream --filter \"${npm_package_name}\" \"/^build:(project:|storybook).*$/\"",
    "build:storybook": "storybook build",
    "watch:build": "pnpm --if-present --workspace-concurrency=Infinity --filter \"${npm_package_name}\" --parallel \"/^watch:build:storybook$/\"",
    "watch:build:storybook": "storybook dev -p 6006",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-storybook": "storybook build",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/blocks": "^8.6.14",
    "@storybook/experimental-addon-test": "^8.6.14",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@storybook/test": "^8.6.15",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
