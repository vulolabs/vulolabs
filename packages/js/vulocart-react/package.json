{
  "name": "@vulocart/react",
  "version": "1.0.0",
  "private": true,
  "description": "React components for @vulocart/sdk - <BuyButton>, <EmbeddedCart>, <EmbeddedCheckout>, <VuloCartProvider>. Works in any React app, including Next.js Client Components.",
  "license": "GPL-2.0-or-later",
  "author": "VuloLabs",
  "type": "module",
  "main": "./dist/vulocart-react.cjs.js",
  "module": "./dist/vulocart-react.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vulocart-react.esm.js",
      "require": "./dist/vulocart-react.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && node build.mjs && tsc --emitDeclarationOnly --outDir dist",
    "watch": "node build.mjs --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@vulocart/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  }
}
